# ============================================================
# Windows 11 AI Agent (RU) — шаблон конфигурации
# ============================================================
# Инструкция:
#   1. Скопируй этот файл в .env:
#        copy .env.example .env
#   2. Открой .env и впиши свои значения.
#   3. Никогда не коммить .env в Git — он в .gitignore!
# ============================================================

# === Telegram ===
# Получить токен: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_token_here

# === Пути (опционально — по умолчанию agent_data/ и models/) ===
# AGENT_DATA_DIR=agent_data
# MODELS_DIR=models

# === LLM ===
LLM_MODEL_PATH=models/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
EMBED_MODEL=BAAI/bge-m3

# === RAG ===
# Порог косинусной близости: выше — строже, ниже — больше шума
RAG_THRESHOLD=0.60
RAG_TOP_K=3